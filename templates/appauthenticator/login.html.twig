{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block header %}{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-1: #f7f2e8;
            --bg-2: #e8d8c6;
            --ink: #1f2a44;
            --muted: #5c667a;
            --accent: #1f2a44;
            --card: #fffaf2;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Georgia", "Times New Roman", serif;
            color: var(--ink);
            background: radial-gradient(1200px 700px at 10% 10%, var(--bg-2), var(--bg-1));
        }

        .auth-wrap {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 48px 20px;
        }

        .auth-card {
            width: min(480px, 100%);
            background: var(--card);
            border: 1px solid #e2d6c5;
            box-shadow: 0 24px 70px rgba(70, 45, 30, 0.15);
            border-radius: 18px;
            padding: 32px;
        }

        .auth-title {
            margin: 0 0 6px;
            font-size: 28px;
            letter-spacing: 0.5px;
        }

        .auth-subtitle {
            margin: 0 0 24px;
            color: var(--muted);
        }

        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }

        .auth-field input {
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #d8c6b5;
            background: #fff;
            font-size: 16px;
        }

        .auth-field input:focus {
            outline: 2px solid rgba(164, 78, 47, 0.3);
            border-color: var(--accent);
        }

        .auth-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 10px;
        }

        .auth-button {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 12px 18px;
            border-radius: 999px;
            cursor: pointer;
            font-size: 15px;
            letter-spacing: 0.3px;
        }

        .auth-link {
            color: var(--muted);
            text-decoration: none;
        }

        .auth-alert {
            background: #fbe3dd;
            border: 1px solid #e0a38f;
            color: #7b2d14;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 16px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-wrap">
        <form class="auth-card" method="post">
            <h1 class="auth-title">Se connecter</h1>
            <p class="auth-subtitle">Accédez à votre espace MyBookstore.</p>

            {% if error %}
                <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="auth-field">
                <label for="username">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
            </div>

            <div class="auth-field">
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="auth-actions">
                <button class="auth-button" type="submit">Connexion</button>
                <a class="auth-link" href="{{ path('app_register') }}">Créer un compte</a>
            </div>
        </form>
    </div>
{% endblock %}
