{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block header %}{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-1: #f7f2e8;
            --bg-2: #e8d8c6;
            --ink: #1f2a44;
            --muted: #5c667a;
            --accent: #1f2a44;
            --card: #fffaf2;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Georgia", "Times New Roman", serif;
            color: var(--ink);
            background: radial-gradient(1200px 700px at 10% 10%, var(--bg-2), var(--bg-1));
        }

        .auth-wrap {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 48px 20px;
        }

        .auth-card {
            width: min(520px, 100%);
            background: var(--card);
            border: 1px solid #e2d6c5;
            box-shadow: 0 24px 70px rgba(70, 45, 30, 0.15);
            border-radius: 18px;
            padding: 32px;
        }

        .auth-title {
            margin: 0 0 6px;
            font-size: 28px;
            letter-spacing: 0.5px;
        }

        .auth-subtitle {
            margin: 0 0 24px;
            color: var(--muted);
        }

        .auth-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }

        .auth-field input,
        .auth-field textarea {
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #d8c6b5;
            background: #fff;
            font-size: 16px;
        }

        .auth-field input:focus,
        .auth-field textarea:focus {
            outline: 2px solid rgba(164, 78, 47, 0.3);
            border-color: var(--accent);
        }

        .auth-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 10px;
        }

        .auth-button {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 12px 18px;
            border-radius: 999px;
            cursor: pointer;
            font-size: 15px;
            letter-spacing: 0.3px;
        }

        .auth-link {
            color: var(--muted);
            text-decoration: none;
        }

        .auth-errors {
            background: #fbe3dd;
            border: 1px solid #e0a38f;
            color: #7b2d14;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 16px;
        }

        .auth-checkbox {
            display: flex;
            gap: 10px;
            align-items: center;
            font-size: 14px;
            color: var(--muted);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-wrap">
        <div class="auth-card">
            <h1 class="auth-title">Créer un compte</h1>
            <p class="auth-subtitle">Rejoignez MyBookstore et commencez vos achats.</p>

            {% if form_errors(registrationForm) %}
                <div class="auth-errors">{{ form_errors(registrationForm) }}</div>
            {% endif %}

            {{ form_start(registrationForm) }}
                <div class="auth-field">
                    {{ form_label(registrationForm.email, 'Email') }}
                    {{ form_widget(registrationForm.email, { attr: { autocomplete: 'email' } }) }}
                </div>

                <div class="auth-grid">
                    <div class="auth-field">
                        {{ form_label(registrationForm.prenom, 'Prénom') }}
                        {{ form_widget(registrationForm.prenom) }}
                    </div>
                    <div class="auth-field">
                        {{ form_label(registrationForm.nom, 'Nom') }}
                        {{ form_widget(registrationForm.nom) }}
                    </div>
                </div>

                <div class="auth-grid">
                    <div class="auth-field">
                        {{ form_label(registrationForm.telephone, 'Téléphone') }}
                        {{ form_widget(registrationForm.telephone, { attr: { placeholder: 'Optionnel' } }) }}
                    </div>
                    <div class="auth-field">
                        {{ form_label(registrationForm.adresse, 'Adresse') }}
                        {{ form_widget(registrationForm.adresse, { attr: { placeholder: 'Optionnel' } }) }}
                    </div>
                </div>

                <div class="auth-field">
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe') }}
                    {{ form_widget(registrationForm.plainPassword, { attr: { autocomplete: 'new-password' } }) }}
                </div>

                <div class="auth-field auth-checkbox">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions') }}
                </div>

                <div class="auth-actions">
                    <button type="submit" class="auth-button">Créer le compte</button>
                    <a class="auth-link" href="{{ path('app_login') }}">Déjà inscrit ?</a>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
