{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
    <div style="max-width: 1100px; margin: 30px auto; padding: 0 20px;">
        <h1>Mes commandes</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
            {% for commande in commandes %}
                <tr>
                    <td>{{ commande.id }}</td>
                    <td>{{ commande.createdAt ? commande.createdAt|date('Y-m-d H:i') : '' }}</td>
                    <td>{{ commande.statut }}</td>
                    <td>{{ commande.total }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucune commande.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
