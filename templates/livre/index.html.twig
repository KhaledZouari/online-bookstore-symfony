{% extends 'dashboard/layout.html.twig' %}

{% block title %}Livre index{% endblock %}

{% block dashboard_body %}
    <h1>Livre index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Isbn</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Stock</th>
                <th>Couverture</th>
                <th>DatePublication</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for livre in livres %}
            <tr>
                <td>{{ livre.id }}</td>
                <td>{{ livre.titre }}</td>
                <td>{{ livre.isbn }}</td>
                <td>{{ livre.description }}</td>
                <td>{{ livre.prix }}</td>
                <td>{{ livre.stock }}</td>
                <td>
                    {% if livre.image %}
                        <img src="{{ asset('uploads/covers/' ~ livre.image) }}" alt="{{ livre.titre }}" style="max-height: 60px;">
                    {% endif %}
                </td>
                <td>{{ livre.datePublication ? livre.datePublication|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_livre_show', {'id': livre.id}) }}">show</a>
                    <a href="{{ path('app_livre_edit', {'id': livre.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_livre_new') }}">Create new</a>
{% endblock %}
