{% extends 'dashboard/layout.html.twig' %}

{% block title %}Livre{% endblock %}

{% block dashboard_body %}
    <h1>Livre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ livre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ livre.titre }}</td>
            </tr>
            <tr>
                <th>Isbn</th>
                <td>{{ livre.isbn }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ livre.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ livre.prix }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ livre.stock }}</td>
            </tr>
            <tr>
                <th>Couverture</th>
                <td>
                    {% if livre.image %}
                        <img src="{{ asset('uploads/covers/' ~ livre.image) }}" alt="{{ livre.titre }}" style="max-height: 160px;">
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>DatePublication</th>
                <td>{{ livre.datePublication ? livre.datePublication|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_livre_index') }}">back to list</a>

    <a href="{{ path('app_livre_edit', {'id': livre.id}) }}">edit</a>

    {{ include('livre/_delete_form.html.twig') }}
{% endblock %}
