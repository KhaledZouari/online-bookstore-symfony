{% extends 'base.html.twig' %}

{% block title %}MyBookstore{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --paper: #f7f2e8;
            --ink: #1f2a44;
            --muted: #5c667a;
            --accent: #1f2a44;
            --card: #fffaf2;
            --line: #e2d6c5;
        }

        body {
            margin: 0;
            font-family: "Georgia", "Times New Roman", serif;
            color: var(--ink);
            background: var(--paper);
        }

        .hero {
            padding: 60px 20px;
            text-align: center;
            background: linear-gradient(160deg, #f1e2d3, #f7f2e8);
        }

        .hero h1 {
            margin: 0 0 12px;
            font-size: 40px;
        }

        .hero p {
            margin: 0;
            color: var(--muted);
        }

        .section {
            max-width: 1100px;
            margin: 32px auto;
            padding: 0 20px;
        }

        .grid {
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 18px;
        }

        .card h3 {
            margin: 0 0 8px;
        }

        .book-cover {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e6d8c9;
            margin-bottom: 10px;
        }

        .cta {
            display: inline-block;
            margin-top: 18px;
            padding: 10px 18px;
            background: var(--accent);
            color: #fff;
            text-decoration: none;
            border-radius: 999px;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="hero">
        <h1>MyBookstore</h1>
        <p>Decouvrez des livres, auteurs et editeurs en quelques clics.</p>
        <a class="cta" href="{{ path('front_livre_index') }}">Explorer les livres</a>
    </section>

    <section class="section">
        <h2>Categories</h2>
        <div class="grid">
            {% for categorie in categories %}
                <div class="card">
                    <h3>{{ categorie.nom }}</h3>
                    <p>{{ categorie.description ?: 'Aucune description.' }}</p>
                </div>
            {% else %}
                <p>Aucune categorie.</p>
            {% endfor %}
        </div>
    </section>

    <section class="section">
        <h2>Editeurs</h2>
        <div class="grid">
            {% for editeur in editeurs %}
                <div class="card">
                    <h3>{{ editeur.nom }}</h3>
                    <p>{{ editeur.email ?: '' }}</p>
                </div>
            {% else %}
                <p>Aucun editeur.</p>
            {% endfor %}
        </div>
    </section>

    <section class="section">
        <h2>Nouveaux livres</h2>
        <div class="grid">
            {% for livre in livres %}
                <div class="card">
                    {% if livre.image %}
                        <img class="book-cover" src="{{ asset('uploads/covers/' ~ livre.image) }}" alt="{{ livre.titre }}">
                    {% endif %}
                    <h3>{{ livre.titre }}</h3>
                    <p>{{ livre.auteur ? livre.auteur.nom : '' }}</p>
                    <p><strong>{{ livre.prix }}</strong></p>
                </div>
            {% else %}
                <p>Aucun livre.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
